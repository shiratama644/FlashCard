# 認証基盤（Auth.js v5 / P1-d）で使用する環境変数のサンプル。
# 実値は .env.local（gitignore 済み）または Vercel の環境変数に設定する。

# セッション署名用シークレット（必須）。`openssl rand -base64 32` 等で生成。
AUTH_SECRET=

# Google OAuth クライアント（Google Cloud Console で発行）。
# 承認済みリダイレクト URI に <ORIGIN>/api/auth/callback/google を登録する。
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# クラウド同期（Supabase / P1-e）で使用。課金（premium）ユーザーのデータ保存先。
# 無料/ゲストは IndexedDB のままで、これらは使用しない。
# URL は公開値だが、SERVICE_ROLE_KEY は RLS をバイパスする最重要シークレット（サーバ専用）。
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 決済（Stripe / P1-f）で使用。premium サブスクの Checkout / Customer Portal。
# STRIPE_SECRET_KEY はサーバ専用シークレット。test mode の sk_test_... を使う。
# STRIPE_PRICE_ID は課金する price（サブスク商品）の ID（price_...）。
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Webhook 署名検証用（P1-f2 で使用）。Stripe ダッシュボード/CLI が発行する whsec_...。
STRIPE_WEBHOOK_SECRET=
